antidad de incidentes en cada una"}},"type":"object","required":["centroides","areas"],"title":"DatosSalidaCentroides"},"DatosSalidaInferencias":{"properties":{"data":{"type":"object","title":"Data","description":"Diccionario con regresiones por dias de la semana, periodo del dia, areas y combinaciones"},"metadata":{"type":"object","title":"Metadata","description":"Metadata de la consulta"}},"type":"object","required":["data","metadata"],"title":"DatosSalidaInferencias"},"DistribucionUnidades":{"type":"string","enum":["Uniforme","Optimo"],"title":"DistribucionUnidades"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ModoDesplazamiento":{"type":"string","enum":["Lineal","Malla"],"title":"ModoDesplazamiento"},"Salidas":{"type":"string","enum":["area","malla"],"title":"Salidas"},"TipoArea":{"type":"string","enum":["zat","upl","policia","catastrales"],"title":"TipoArea"},"TipoMalla":{"type":"string","enum":["completa","arterial"],"title":"TipoMalla"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}