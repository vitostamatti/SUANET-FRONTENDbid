# SUANET Frontend Environment Variables
# Copy this file to .env.local and configure with your actual values

# Backend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PowerBI Dashboard URLs (previously hardcoded - now configurable)
# These should be the embed URLs from PowerBI with proper access tokens
NEXT_PUBLIC_POWERBI_DESCRIPTIVO_URL=https://app.powerbi.com/view?r=your_descriptivo_token_here
NEXT_PUBLIC_POWERBI_TRAFICO_URL=https://app.powerbi.com/view?r=your_trafico_token_here

# Application Environment
NODE_ENV=development